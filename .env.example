# Notifications internes par email (nouvelle commande, stock bas).
# Laisser SMTP_HOST vide pour desactiver l'envoi (les evenements restent journalises).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
