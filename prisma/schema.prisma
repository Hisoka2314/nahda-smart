generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SELLER
  STOCK_MANAGER
  ACCOUNTANT
  DELIVERY
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
  OUT_OF_STOCK
  ON_ORDER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  SCHOOL
  ADMINISTRATION
  RESELLER
  ASSOCIATION
}

enum CustomerSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  GOOGLE
  STORE
  RECOMMENDATION
}

enum CustomerLevel {
  NEW
  LOYAL
  VIP
  B2B
}

enum CustomerRelationshipStatus {
  GOOD
  NORMAL
  LOYAL
  VIP
  WATCH
  LATE_PAYER
  DISPUTE
  BLOCKED
}

enum CustomerNoteType {
  INFORMATION
  FOLLOW_UP
  PAYMENT
  DELIVERY
  DISPUTE
  SAV
  COMMERCIAL
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum DeliveryMethod {
  HOME_DELIVERY
  PICKUP_IN_STORE
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  PAY_ON_SITE
}

enum QuoteStatus {
  NEW
  STUDYING
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

enum SupplierType {
  IMPORTER
  WHOLESALER
  RESELLER
  INDIVIDUAL
  DISTRIBUTOR
}

enum SupplierPurchaseStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SupplierNoteType {
  INFORMATION
  PAYMENT
  DELIVERY
  QUALITY
  SAV
  COMMERCIAL
  DISPUTE
}

enum DepotType {
  MAIN_DEPOT
  SHOWROOM
  SECONDARY_DEPOT
  STORE
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RESERVED
  RELEASED
}

enum ServiceTicketType {
  RETURN
  REPAIR
  EXCHANGE
  WARRANTY_CLAIM
  TECH_SUPPORT
}

enum ServiceTicketStatus {
  NEW
  IN_REVIEW
  DIAGNOSIS_DONE
  IN_PROGRESS
  WAITING_PARTS
  REPAIRED
  REPLACED
  REFUSED
  CLOSED
}

enum ServiceTicketUrgency {
  LOW
  MEDIUM
  HIGH
}

enum ServiceTicketNoteType {
  INTERNAL
  TECHNICAL
  CLIENT
  PARTS
  RESOLUTION
}

enum FilterInputType {
  CHECKBOX
  RADIO
  RANGE
  BOOLEAN
  SELECT
  MULTI_SELECT
  SEARCH_LIST
  NUMERIC_RANGE
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
  NO_ANSWER
  CALLBACK
  CONVERTED
  LOST
}

model AdminUser {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  passwordHash   String
  role           AdminRole
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  logs           AdminLog[]
  sessions       AdminSession[]
  statusChanges  OrderStatusHistory[]
  stockMovements StockMovement[]
  customerNotes  CustomerNote[]
  supplierNotes  SupplierNote[]
  supplierPurchases SupplierPurchase[]
  supplierPayments SupplierPayment[]
  createdServiceTickets ServiceTicket[]              @relation("ServiceTicketCreatedBy")
  serviceTicketNotes ServiceTicketNote[]             @relation("ServiceTicketNoteAuthor")
  serviceTicketStatusChanges ServiceTicketStatusHistory[] @relation("ServiceTicketStatusChangedBy")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLog {
  id        String    @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Brand {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logoPath        String?
  isActive        Boolean   @default(true)
  isOfficialAsset Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  parentId         String?
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  icon             String?
  bannerUrl        String?
  description      String?
  order            Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  filterGroups     FilterGroup[]
  filterAttributes FilterAttribute[]

  @@index([parentId])
  @@index([order])
  @@index([isActive])
}

model Product {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  sku                  String                  @unique
  barcode              String?
  brandId              String
  brand                Brand                   @relation(fields: [brandId], references: [id])
  categoryId           String
  category             Category                @relation(fields: [categoryId], references: [id])
  shortDescription     String?
  description          String                  @db.Text
  technicalDescription String?                 @db.Text
  priceBuy             Decimal                 @db.Decimal(12, 2)
  priceSell            Decimal                 @db.Decimal(12, 2)
  promoPrice           Decimal?                @db.Decimal(12, 2)
  margin               Decimal?                @db.Decimal(8, 2)
  warrantyMonths       Int                     @default(12)
  condition            ProductCondition        @default(NEW)
  status               ProductStatus           @default(DRAFT)
  isPromo              Boolean                 @default(false)
  isNew                Boolean                 @default(false)
  isRecommended        Boolean                 @default(false)
  isBestSeller         Boolean                 @default(false)
  rating               Decimal?                @db.Decimal(3, 2)
  reviewCount          Int                     @default(0)
  seoTitle             String?
  seoDescription       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  images               ProductImage[]
  attributeValues      ProductAttributeValue[]
  orderItems           OrderItem[]
  quoteItems           QuoteItem[]
  purchaseItems        SupplierPurchaseItem[]
  stocks               Stock[]
  stockMovements       StockMovement[]
  serviceTickets       ServiceTicket[]
  reviews              ProductReview[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)

  @@index([productId])
  @@index([order])
}

model FilterGroup {
  id         String            @id @default(cuid())
  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  order      Int               @default(0)
  defaultOpen Boolean          @default(false)
  isAdvanced Boolean           @default(false)
  visible    Boolean           @default(true)
  attributes FilterAttribute[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([order])
  @@index([visible])
}

model FilterAttribute {
  id              String                  @id @default(cuid())
  groupId         String
  group           FilterGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label           String
  slug            String
  type            FilterInputType
  unit            String?
  filterable      Boolean                 @default(true)
  searchable      Boolean                 @default(false)
  visible         Boolean                 @default(true)
  order           Int                     @default(0)
  options         FilterOption[]
  productValues   ProductAttributeValue[]

  @@unique([categoryId, slug])
  @@index([groupId])
  @@index([categoryId])
  @@index([type])
  @@index([visible])
  @@index([order])
}

model FilterOption {
  id          String                  @id @default(cuid())
  attributeId String
  attribute   FilterAttribute         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  label       String
  value       String
  order       Int                     @default(0)
  visible     Boolean                 @default(true)
  productValues ProductAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@index([visible])
  @@index([order])
}

model ProductAttributeValue {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    FilterAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  optionId     String?
  option       FilterOption?   @relation(fields: [optionId], references: [id], onDelete: SetNull)
  valueString  String?
  valueNumber  Decimal?        @db.Decimal(12, 2)
  valueBoolean Boolean?
  valueJson    Json?

  @@index([productId])
  @@index([attributeId])
  @@index([optionId])
  @@index([productId, attributeId])
}

model Customer {
  id                 String                     @id @default(cuid())
  name               String
  phone              String
  email              String?
  city               String?
  address            String?
  type               CustomerType
  source             CustomerSource             @default(WEBSITE)
  level              CustomerLevel              @default(NEW)
  relationshipStatus CustomerRelationshipStatus @default(NORMAL)
  organizationName   String?
  internalNotes      String?                    @db.Text
  tags               String[]                   @default([])
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  orders             Order[]
  quotes             Quote[]
  serviceTickets     ServiceTicket[]
  notes              CustomerNote[]
  contactMessages    ContactMessage[]

  @@index([phone])
  @@index([type])
  @@index([source])
  @@index([level])
  @@index([relationshipStatus])
}

model CustomerNote {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?
  author     AdminUser?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type       CustomerNoteType @default(INFORMATION)
  content    String           @db.Text
  private    Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([customerId])
  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id])
  status              OrderStatus          @default(PENDING_CONFIRMATION)
  deliveryMethod      DeliveryMethod
  paymentMethod       PaymentMethod
  subtotal            Decimal              @db.Decimal(12, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  customerNote        String?              @db.Text
  internalNote        String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  serviceTickets      ServiceTicket[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   AdminUser?  @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([status])
  @@index([changedById])
  @@index([createdAt])
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String      @unique
  customerId       String?
  customer         Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status           QuoteStatus @default(NEW)
  message          String?     @db.Text
  organizationName String?
  urgency          String?
  needType         String?
  budget           Decimal?    @db.Decimal(12, 2)
  total            Decimal?    @db.Decimal(12, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            QuoteItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  quantity    Int
  unitPrice   Decimal? @db.Decimal(12, 2)
  totalPrice  Decimal? @db.Decimal(12, 2)

  @@index([quoteId])
  @@index([productId])
}

model Supplier {
  id            String             @id @default(cuid())
  name          String
  phone         String?
  email         String?
  city          String?
  address       String?
  type          SupplierType
  notes         String?            @db.Text
  tags          String[]           @default([])
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  purchases     SupplierPurchase[]
  payments      SupplierPayment[]
  supplierNotes SupplierNote[]
  serviceTickets ServiceTicket[]

  @@index([type])
  @@index([name])
  @@index([city])
  @@index([isActive])
}

model SupplierPurchase {
  id           String                 @id @default(cuid())
  supplierId   String
  supplier     Supplier               @relation(fields: [supplierId], references: [id])
  depotId      String?
  depot        Depot?                 @relation(fields: [depotId], references: [id], onDelete: SetNull)
  reference    String?
  status       SupplierPurchaseStatus @default(DRAFT)
  total        Decimal                @db.Decimal(12, 2)
  paid         Decimal                @default(0) @db.Decimal(12, 2)
  remaining    Decimal                @default(0) @db.Decimal(12, 2)
  transportFee Decimal                @default(0) @db.Decimal(12, 2)
  customsFee   Decimal                @default(0) @db.Decimal(12, 2)
  otherFee     Decimal                @default(0) @db.Decimal(12, 2)
  date         DateTime
  receivedAt   DateTime?
  notes        String?                @db.Text
  createdById  String?
  createdBy    AdminUser?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  items        SupplierPurchaseItem[]
  payments     SupplierPayment[]

  @@index([supplierId])
  @@index([depotId])
  @@index([status])
  @@index([date])
  @@index([createdById])
}

model SupplierPurchaseItem {
  id           String           @id @default(cuid())
  purchaseId   String
  purchase     SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  quantity     Int
  unitBuyPrice Decimal          @db.Decimal(12, 2)
  total        Decimal          @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

model SupplierPayment {
  id          String           @id @default(cuid())
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseId  String
  purchase    SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount      Decimal          @db.Decimal(12, 2)
  method      String?
  note        String?          @db.Text
  createdById String?
  createdBy   AdminUser?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([supplierId])
  @@index([purchaseId])
  @@index([createdById])
  @@index([createdAt])
}

model SupplierNote {
  id          String           @id @default(cuid())
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  authorId    String?
  author      AdminUser?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type        SupplierNoteType  @default(INFORMATION)
  content     String           @db.Text
  private     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([supplierId])
  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model Depot {
  id          String          @id @default(cuid())
  name        String
  type        DepotType
  address     String?
  managerName String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stocks      Stock[]
  movements   StockMovement[]
  supplierPurchases SupplierPurchase[]

  @@index([type])
  @@index([isActive])
}

model Stock {
  id                String  @id @default(cuid())
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  depotId           String
  depot             Depot   @relation(fields: [depotId], references: [id], onDelete: Cascade)
  quantity          Int     @default(0)
  lowStockThreshold Int     @default(3)

  @@unique([productId, depotId])
  @@index([productId])
  @@index([depotId])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  depotId     String
  depot       Depot             @relation(fields: [depotId], references: [id])
  type        StockMovementType
  quantity    Int
  reason      String?
  reference   String?
  createdById String?
  createdBy   AdminUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@index([depotId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model ServiceTicket {
  id            String                  @id @default(cuid())
  ticketNumber  String                  @unique
  customerId    String
  customer      Customer                @relation(fields: [customerId], references: [id])
  orderId       String?
  order         Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  productId     String?
  product       Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  type          ServiceTicketType
  urgency       ServiceTicketUrgency    @default(MEDIUM)
  status        ServiceTicketStatus     @default(NEW)
  problem       String                  @db.Text
  internalNotes String?                 @db.Text
  createdById   String?
  createdBy     AdminUser?              @relation("ServiceTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedAt      DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  notes         ServiceTicketNote[]
  statusHistory ServiceTicketStatusHistory[]

  @@index([ticketNumber])
  @@index([customerId])
  @@index([orderId])
  @@index([productId])
  @@index([supplierId])
  @@index([type])
  @@index([urgency])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model ServiceTicketNote {
  id        String                @id @default(cuid())
  ticketId  String
  ticket    ServiceTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    AdminUser?            @relation("ServiceTicketNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  type      ServiceTicketNoteType @default(INTERNAL)
  content   String                @db.Text
  private   Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([ticketId])
  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model ServiceTicketStatusHistory {
  id          String              @id @default(cuid())
  ticketId    String
  ticket      ServiceTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status      ServiceTicketStatus
  note        String?
  changedById String?
  changedBy   AdminUser?          @relation("ServiceTicketStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([ticketId])
  @@index([status])
  @@index([changedById])
  @@index([createdAt])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([order])
}

model ContactMessage {
  id            String               @id @default(cuid())
  name          String
  phone         String
  email         String?
  subject       String
  message       String               @db.Text
  status        ContactMessageStatus @default(NEW)
  callAttempts  Int                  @default(0)
  callbackAt    DateTime?
  lastContactAt DateTime?
  internalNote  String?              @db.Text
  customerId    String?
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([callbackAt])
  @@index([customerId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String       @db.Text
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([productId, status])
  @@index([status])
  @@index([createdAt])
  @@map("product_reviews")
}

// Coordonnees editables depuis le back-office (une seule ligne, id = "site").
model SiteSetting {
  id               String   @id @default("site")
  companyName      String   @default("Nahda Smart")
  email            String   @default("contact@nahdasmart.ma")
  phone            String   @default("0800 123 456")
  whatsapp         String   @default("212600000000")
  addressPrimary   String   @default("Casablanca, Maarif")
  addressSecondary String   @default("")
  mapsUrl          String   @default("")
  facebookUrl      String   @default("")
  instagramUrl     String   @default("")
  openingHours     String   @default("Lun - Sam : 9h00 - 18h00")
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}
